LIBRARY		"zlib"

DESCRIPTION	'"""zlib data compression library"""'

EXETYPE		WINDOWS

VERSION		1.25

CODE    PRELOAD MOVEABLE DISCARDABLE
DATA    PRELOAD MOVEABLE SINGLE

HEAPSIZE	32768,8192

EXPORTS
; basic functions
	zlibVersion
	deflate
	deflateEnd
	inflate
	inflateEnd
; advanced functions
	deflateSetDictionary
	deflateCopy
	deflateReset
	deflateParams
	deflateTune
	deflateBound
	deflatePending
	deflatePrime
	deflateSetHeader
	inflateSetDictionary
	inflateSync
	inflateCopy
	inflateReset
	inflateReset2
	inflatePrime
	inflateMark
	inflateGetHeader
	inflateBack
	inflateBackEnd
	zlibCompileFlags
; utility functions
	compress
	compress2
	compressBound
	uncompress
	uncompress2
	gzopen
	gzdopen
	gzsetparams
	gzread
	gzwrite
	_gzprintf
	gzputs
	gzgets
	gzputc
	gzgetc
	gzungetc
	gzflush
	gzseek
	gzrewind
	gztell
	gzeof
	gzdirect
	gzclose
	gzerror
	gzclearerr
; checksum functions
	adler32
	crc32
	adler32_combine
	crc32_combine
; various hacks, don't look :)
	deflateInit_
	deflateInit2_
	inflateInit_
	inflateInit2_
	inflateBackInit_
	zError
	inflateSyncPoint
	get_crc_table
	inflateUndermine
	inflateValidate
	inflateResetKeep
	deflateResetKeep
; MiniZip
	_fill_fopen_filefunc
	unzClose
	unzCloseCurrentFile
	unzeof
	unzGetCurrentFileInfo
	unzGetGlobalComment
	unzGetGlobalInfo
	unzGetLocalExtrafield
	unzGoToFirstFile
	unzGoToNextFile
	unzLocateFile
	unzOpen
	unzOpen2
	unzOpenCurrentFile
	unzOpenCurrentFile2
	unzReadCurrentFile
	unzStringFileNameCompare
	unztell
	zipClose
	zipCloseFileInZip
	zipCloseFileInZipRaw
	zipOpen
	zipOpen2
	zipOpenNewFileInZip
	zipOpenNewFileInZip2
	zipWriteInFileInZip
; MiniZip 0.18+
	unzGetFilePos
	unzGetOffset
	unzGoToFilePos
	unzOpenCurrentFile3
	unzOpenCurrentFilePassword
	unzSetOffset
	zipOpenNewFileInZip3
